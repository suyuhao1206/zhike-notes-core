/* pages/profile/profile.wxss */
.container {
  padding: 0 0 calc(env(safe-area-inset-bottom) + var(--space-md)) 0;
  background: var(--background-color);
  min-height: 100vh;
}

/* 顶部背景 */
.container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background: linear-gradient(to bottom, var(--primary-bg) 0%, transparent 100%);
  z-index: 0;
}

/* 未登录卡片 */
.login-card {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 500rpx;
  background: var(--surface-color);
  border-radius: var(--radius-xl);
  margin: var(--space-2xl) var(--space-md);
  box-shadow: var(--shadow-sm);
  position: relative;
  z-index: 1;
}

.login-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.login-icon {
  font-size: 96rpx;
  margin-bottom: var(--space-md);
}

.login-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--space-xs);
}

.login-desc {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-bottom: var(--space-xl);
}

.login-btn {
  background: var(--gradient-primary);
  color: var(--text-inverse);
  font-size: var(--font-base);
  font-weight: 600;
  padding: 16rpx 64rpx;
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-glow);
}

/* 已登录状态包裹 */
.profile-content {
  position: relative;
  z-index: 1;
  padding: var(--space-lg) var(--space-md) var(--space-md);
}

/* 用户信息 */
.user-card {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md);
  margin-bottom: var(--space-lg);
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid var(--surface-color);
  box-shadow: var(--shadow-md);
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: var(--font-xl);
  font-weight: 800;
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.user-id {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  background: var(--gray-100);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  display: inline-block;
}

/* 统一卡片样式 */
.stats-card, .menu-card, .settings-card, .actions-card {
  background: var(--surface-color);
  border-radius: var(--radius-lg);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-sm);
}

/* 统计区域 */
.stats-header {
  display: none; /* 隐藏"学习统计"文字，让数据本身说话 */
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  padding: var(--space-lg) 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-value {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: var(--font-xs);
  color: var(--text-secondary);
}

/* 列表容器共同样式 */
.menu-header, .settings-header {
  padding: var(--space-md) var(--space-md) 0;
}

.menu-title, .settings-title {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-secondary);
  padding-left: var(--space-xs);
}

.menu-list, .settings-list, .actions-card {
  display: flex;
  flex-direction: column;
  padding: 0 var(--space-md);
}

/* 列表项共同样式 */
.menu-item, .setting-item, .action-item {
  display: flex;
  align-items: center;
  padding: var(--space-md) var(--space-xs);
  border-bottom: 1px solid var(--border-light);
  transition: background-color var(--transition-fast);
}

.menu-item:last-child, .setting-item:last-child, .action-item:last-child {
  border-bottom: none;
}

.menu-item:active, .setting-item:active, .action-item:active {
  background-color: var(--gray-50);
}

.menu-icon, .setting-icon, .action-icon {
  font-size: 40rpx;
  margin-right: var(--space-sm);
}

.menu-name, .setting-name, .action-name {
  flex: 1;
  font-size: var(--font-base);
  color: var(--text-primary);
  font-weight: 500;
}

.menu-arrow, .setting-arrow, .action-arrow {
  font-size: var(--font-sm);
  color: var(--text-placeholder);
  font-family: monospace; /* 为了让箭头更纯粹 */
  margin-left: var(--space-sm);
}

.menu-count {
  font-size: var(--font-xs);
  font-weight: 600;
  color: var(--primary-color);
  background: var(--primary-bg);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
}

.setting-value {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}


.action-item:last-child {
  justify-content: center;
}

.action-item:last-child .action-name,
.action-item:nth-last-child(2) .action-name {
  flex: none;
  text-align: center;
}

.action-item:nth-last-child(2) {
  border-top: 1px solid var(--border-light);
  color: var(--error-color);
}

.action-item:nth-last-child(2) .action-name {
  color: var(--error-color);
}