/* pages/notes/notes.wxss */

.container {
  padding: 0; /* Override default container padding for full-width sticky headers */
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 搜索栏 - 毛玻璃吸顶 */
.search-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(249, 250, 251, 0.85); /* var(--gray-50) */
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: var(--space-md) var(--space-md) var(--space-sm);
  border-bottom: 1px solid var(--border-light);
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: var(--surface-color);
  border-radius: var(--radius-full);
  padding: 16rpx 32rpx;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border-color);
  transition: all var(--transition-fast);
}

.search-input-wrapper:focus-within {
  border-color: var(--primary-color);
  box-shadow: 0 0 0 6rpx var(--primary-bg);
}

.search-icon {
  font-size: 32rpx;
  margin-right: var(--space-sm);
  color: var(--text-placeholder);
}

.search-input {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--text-primary);
}

/* 课程筛选 - 横向滚动 */
.course-filter {
  position: sticky;
  top: 108rpx; /* Height of search bar approx */
  z-index: 15;
  background: rgba(249, 250, 251, 0.95);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  padding: var(--space-sm) 0;
  border-bottom: 1px solid var(--border-color);
}

.course-scroll {
  white-space: nowrap;
  padding: 0 var(--space-md);
}

.course-tag {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 32rpx;
  margin-right: var(--space-sm);
  background: var(--surface-color);
  border-radius: var(--radius-full);
  font-size: var(--font-sm);
  font-weight: 500;
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
  transition: all var(--transition-fast);
  box-shadow: var(--shadow-sm);
}

.course-tag:active {
  transform: scale(0.95);
}

.course-tag.active {
  background: var(--gradient-primary);
  color: var(--text-inverse);
  border-color: transparent;
  box-shadow: var(--shadow-glow);
}

/* 笔记列表 */
.notes-list {
  flex: 1;
  padding: var(--space-md);
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.note-card {
  background: var(--surface-color);
  border-radius: var(--radius-lg);
  padding: var(--space-md);
  box-shadow: var(--shadow-sm);
  transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  position: relative;
  overflow: hidden;
}

.note-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: var(--info-color); /* 默认标识色 */
  opacity: 0.8;
}

/* 为不同的卡片状态或奇偶添加细微渐变差异（可选） */
.note-card:nth-child(even)::before {
  background: var(--gradient-primary);
}

.note-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

.note-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-sm);
}

.note-course {
  font-size: var(--font-xs);
  color: var(--primary-dark);
  background: var(--primary-bg);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.note-time {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.note-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: var(--space-xs);
  line-height: 1.4;
}

.note-summary {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: var(--space-md);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.note-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid var(--border-light);
  padding-top: var(--space-sm);
}

.note-duration {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  display: flex;
  align-items: center;
}

.note-actions {
  display: flex;
  gap: var(--space-sm);
}

.action-btn {
  font-size: var(--font-xs);
  padding: 8rpx 20rpx;
  border-radius: var(--radius-sm);
  transition: all var(--transition-fast);
  display: flex;
  align-items: center;
  background: var(--gray-100);
  color: var(--text-secondary);
}

.action-btn:active {
  background: var(--gray-200);
}

.action-btn.delete {
  background: transparent;
  color: var(--text-placeholder);
}

.action-btn.delete:active {
  color: var(--error-color);
  background: var(--error-bg);
}

/* 空状态增强 */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-2xl) var(--space-md);
  text-align: center;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: var(--space-md);
  opacity: 0.5;
  filter: grayscale(100%);
}

.empty-text {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: var(--space-xs);
}

.empty-hint {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

/* 快速创建浮动按钮 (FAB) - 保持与首页一致 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 112rpx;
  height: 112rpx;
  background: var(--gradient-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-glow);
  z-index: 100;
  transition: transform var(--transition-fast);
  animation: pulse 2s infinite cubic-bezier(0.4, 0, 0.2, 1);
}

.fab:active {
  transform: scale(0.9);
}

@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(94, 92, 230, 0.4); }
  70% { box-shadow: 0 0 0 20rpx rgba(94, 92, 230, 0); }
  100% { box-shadow: 0 0 0 0 rgba(94, 92, 230, 0); }
}

.fab-icon {
  font-size: 64rpx;
  color: var(--text-inverse);
  font-weight: 300;
  margin-bottom: 8rpx;
}
