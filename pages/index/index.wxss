/* pages/index/index.wxss */

/* 搜索栏 */
.search-bar {
  margin-bottom: var(--space-md);
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--background-color);
  padding-bottom: 8rpx;
}

.search-input-placeholder {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 20rpx 32rpx;
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-sm);
  border: 1px solid rgba(255, 255, 255, 0.5);
  transition: all var(--transition-fast);
}

.search-input-placeholder:active {
  background: rgba(255, 255, 255, 0.9);
  transform: scale(0.98);
}

.search-icon {
  font-size: 32rpx;
  margin-right: var(--space-sm);
  opacity: 0.6;
  filter: drop-shadow(0 2rpx 4rpx rgba(0,0,0,0.1));
}

.search-text {
  font-size: var(--font-sm);
  color: var(--text-placeholder);
}

/* 欢迎卡片 */
.welcome-card {
  background: var(--gradient-primary);
  color: var(--text-inverse);
  position: relative;
  overflow: hidden;
  border: none;
}

.welcome-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 70%);
  border-radius: 50%;
}

.welcome-title {
  font-size: var(--font-xl);
  font-weight: 700;
  display: block;
  margin-bottom: var(--space-xs);
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.welcome-subtitle {
  font-size: var(--font-sm);
  opacity: 0.85;
}

.quick-actions {
  display: flex;
  margin-top: var(--space-lg);
  gap: var(--space-md);
  position: relative;
  z-index: 1;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-md) var(--space-sm);
  background-color: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: var(--radius-md);
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: all var(--transition-fast);
}

.action-btn:active {
  transform: scale(0.95);
  background-color: rgba(255, 255, 255, 0.25);
  box-shadow: 0 0 20rpx rgba(255, 255, 255, 0.2);
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: var(--space-xs);
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.2));
}

.action-text {
  font-size: var(--font-xs);
  font-weight: 500;
}

/* 核心能力区 */
.section {
  margin-top: var(--space-lg);
}

.capability-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-md);
}

.capability-card {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
  background: var(--surface-color);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  min-height: 140rpx;
  box-sizing: border-box;
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
  transition: transform var(--transition-fast), box-shadow var(--transition-fast);
}

.capability-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: var(--gradient-primary);
  opacity: 0.8;
}

.capability-card:active {
  transform: translateY(-4rpx) scale(0.98);
  box-shadow: var(--shadow-md);
}

.capability-icon {
  font-size: 44rpx;
  line-height: 1;
}

.capability-content {
  flex: 1;
  min-width: 0;
}

.capability-name {
  display: block;
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.capability-desc {
  display: block;
  font-size: var(--font-xs);
  line-height: 1.4;
  color: var(--text-secondary);
}

/* 课程和笔记列表 */
.course-list, .note-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.course-item,
.note-item {
  background-color: var(--surface-color);
  border-radius: var(--radius-lg);
  padding: var(--space-md);
  box-shadow: var(--shadow-sm);
  transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  position: relative;
  overflow: hidden;
  margin-bottom: 0; /* 依靠 gap 控制间距 */
}

.course-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: var(--success-color); /* 课程用成功色调标识 */
  opacity: 0.7;
}

.note-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: var(--info-color); /* 笔记用信息色调标识 */
  opacity: 0.7;
}

.course-item:active, .note-item:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

.course-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-xs);
}

.course-name {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.course-note-count {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  background: var(--gray-100);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
}

.course-time {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.note-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-sm);
}

.note-course {
  font-size: var(--font-xs);
  color: var(--primary-dark);
  background-color: var(--primary-bg);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.note-time {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.note-title {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: var(--space-xs);
}

.note-summary {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.5;
}

/* 空状态增强 */
.empty-state {
  /* 已经在 app.wxss 中定义基础样式，这里添加首页特有微调 */
  background: transparent;
  box-shadow: none;
  padding: var(--space-xl) var(--space-md);
}

.empty-icon {
  font-size: 88rpx;
  opacity: 0.6;
  filter: saturate(0.5); /* 柔和色调 */
}

/* 快速创建浮动按钮 (FAB) */
.quick-create-fab {
  position: fixed;
  right: 40rpx;
  bottom: 140rpx;
  width: 112rpx;
  height: 112rpx;
  background: var(--gradient-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-glow);
  z-index: 100;
  transition: transform var(--transition-fast);
  animation: pulse 2s infinite cubic-bezier(0.4, 0, 0.2, 1);
}

.quick-create-fab:active {
  transform: scale(0.9);
}

@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(94, 92, 230, 0.4); }
  70% { box-shadow: 0 0 0 20rpx rgba(94, 92, 230, 0); }
  100% { box-shadow: 0 0 0 0 rgba(94, 92, 230, 0); }
}

.quick-create-fab .fab-icon {
  font-size: 64rpx;
  color: var(--text-inverse);
  font-weight: 300;
  margin-bottom: 8rpx; /* 微调居中 */
}

/* 快速创建菜单 */
.quick-create-menu {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
}

.menu-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  animation: fadeInMask var(--transition-fast) forwards;
}

@keyframes fadeInMask {
  from { opacity: 0; }
  to { opacity: 1; }
}

.menu-content {
  position: absolute;
  right: 40rpx;
  bottom: 280rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.5);
  border-radius: var(--radius-lg);
  padding: var(--space-xs);
  box-shadow: var(--shadow-lg);
  min-width: 260rpx;
  animation: slideUpFade var(--transition-fast) forwards;
  transform-origin: bottom right;
}

@keyframes slideUpFade {
  from { 
    opacity: 0; 
    transform: translateY(20rpx) scale(0.9);
  }
  to { 
    opacity: 1; 
    transform: translateY(0) scale(1);
  }
}

.menu-content .menu-item {
  display: flex;
  align-items: center;
  padding: var(--space-md) var(--space-lg);
  border-radius: var(--radius-md);
  transition: background-color var(--transition-fast);
}

.menu-content .menu-item:active {
  background: rgba(0, 0, 0, 0.05);
}

.menu-content .menu-icon {
  font-size: 40rpx;
  margin-right: var(--space-md);
}

.menu-content .menu-text {
  font-size: var(--font-base);
  font-weight: 500;
  color: var(--text-primary);
}
