/* pages/qa/qa.wxss */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--background-color);
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: var(--space-md);
  padding-bottom: 240rpx; /* 给底部输入框留出充足空间 */
}

.message-item {
  margin-bottom: var(--space-lg);
  max-width: 85%;
  display: flex;
  flex-direction: column;
}

.message-item.user {
  margin-left: auto;
  align-items: flex-end;
}

.message-item.ai {
  margin-right: auto;
  align-items: flex-start;
}

.message-header {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  margin-bottom: var(--space-xs);
  padding: 0 8rpx;
}

.sender-name {
  font-size: var(--font-xs);
  font-weight: 600;
}

.message-item.user .sender-name {
  color: var(--text-tertiary);
  display: none; /* 用户的名字可以隐藏，通过布局就能看出 */
}

.message-item.ai .sender-name {
  color: var(--primary-dark);
}

/* 为AI增加一个小图标标识 */
.message-item.ai .sender-name::before {
  content: '✨ ';
}

.message-time {
  font-size: 20rpx;
  color: var(--text-placeholder);
}

.message-content {
  padding: 20rpx 28rpx;
  border-radius: var(--radius-xl);
  font-size: var(--font-base);
  line-height: 1.6;
  box-shadow: var(--shadow-sm);
  word-break: break-all;
}

.message-item.user .message-content {
  background: var(--gradient-primary);
  color: var(--text-inverse);
  border-bottom-right-radius: 4rpx;
}

.message-item.ai .message-content {
  background: var(--surface-color);
  color: var(--text-primary);
  border-bottom-left-radius: 4rpx;
  border: 1px solid var(--border-color);
}

.message-actions {
  margin-top: var(--space-xs);
  padding: 0 8rpx;
}

.action-btn {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  display: inline-flex;
  align-items: center;
  transition: color var(--transition-fast);
}

.action-btn:active {
  color: var(--primary-color);
}

/* 发送中状态 */
.message-item.sending {
  opacity: 0.9;
}

.typing-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-bottom: 8rpx;
  display: block;
}

.typing-indicator {
  display: flex;
  gap: 8rpx;
  align-items: center;
  height: 24rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  background: var(--primary-color);
  border-radius: 50%;
  animation: typing 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes typing {
  0%, 80%, 100% { transform: scale(0); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 88rpx;
  margin-bottom: var(--space-md);
  opacity: 0.8;
}

.empty-text {
  font-size: var(--font-base);
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.5;
}

/* 快捷问题 */
.quick-questions {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom) + 160rpx);
  left: 0;
  right: 0;
  padding: var(--space-md);
  background: linear-gradient(to top, var(--background-color) 70%, transparent);
  z-index: 10;
}

.quick-title {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  margin-bottom: var(--space-sm);
  display: block;
  text-align: center;
}

.quick-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--space-sm);
}

.quick-item {
  padding: 12rpx 24rpx;
  background: var(--surface-color);
  border-radius: var(--radius-full);
  border: 1px solid var(--primary-light);
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-fast);
}

.quick-item:active {
  background: var(--primary-bg);
  transform: scale(0.96);
}

.quick-text {
  font-size: var(--font-xs);
  color: var(--primary-dark);
  font-weight: 500;
}

/* 输入区域 */
.input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: var(--space-sm) var(--space-md) calc(env(safe-area-inset-bottom) + var(--space-sm));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  border-top: 1px solid var(--border-light);
  z-index: 20;
}

.input-container {
  display: flex;
  align-items: flex-end;
  gap: var(--space-sm);
  background: var(--surface-color);
  border-radius: var(--radius-lg);
  padding: 12rpx 12rpx 12rpx 24rpx;
  border: 1px solid var(--border-color);
  box-shadow: inset 0 2rpx 4rpx rgba(0,0,0,0.02);
  transition: border-color var(--transition-fast);
}

.input-container:focus-within {
  border-color: var(--primary-light);
}

.input-box {
  flex: 1;
  min-height: 44rpx;
  max-height: 160rpx;
  font-size: var(--font-base);
  line-height: 1.5;
  color: var(--text-primary);
  padding: 12rpx 0;
}

.send-btn {
  font-size: var(--font-sm);
  font-weight: 600;
  padding: 16rpx 32rpx;
  border-radius: var(--radius-md);
  background: var(--gray-200);
  color: var(--text-tertiary);
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-fast);
}

.send-btn::after {
  border: none;
}

.send-btn.active {
  background: var(--gradient-primary);
  color: var(--text-inverse);
  box-shadow: var(--shadow-glow);
}

.send-btn.active:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.send-btn[disabled] {
  opacity: 0.6;
}

.input-actions {
  display: flex;
  justify-content: center;
  margin-top: var(--space-xs);
}

.clear-btn {
  font-size: var(--font-xs);
  color: var(--text-placeholder);
  padding: 8rpx 16rpx;
  transition: color var(--transition-fast);
}

.clear-btn:active {
  color: var(--error-color);
}