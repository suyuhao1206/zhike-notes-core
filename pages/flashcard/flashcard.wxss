/* pages/flashcard/flashcard.wxss */
.container {
  padding: var(--space-md) var(--space-md) calc(env(safe-area-inset-bottom) + 120rpx);
  background: var(--background-color);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶部信息 */
.header {
  text-align: center;
  margin-bottom: var(--space-xl);
}

.title {
  font-size: var(--font-xl);
  font-weight: 800;
  color: var(--text-primary);
  display: block;
  margin-bottom: var(--space-xs);
}

.subtitle, .due-subtitle {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  display: block;
}

.due-subtitle {
  margin-top: 4rpx;
  color: var(--warning-color);
}

/* 卡片区域 - 3D 翻转效果 */
.card-container {
  flex: 1;
  perspective: 1000px;
  margin-bottom: var(--space-xl);
}

.flashcard {
  width: 100%;
  height: 60vh;
  position: relative;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  transform-style: preserve-3d;
}

.flashcard.flipped {
  transform: rotateY(180deg);
}

.card-face {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  background: var(--surface-color);
  border-radius: var(--radius-xl);
  padding: var(--space-xl) var(--space-lg);
  box-shadow: var(--shadow-md);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.card-back {
  transform: rotateY(180deg);
  background: var(--gray-50);
  border: 1px solid var(--border-light);
}

.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.card-label {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  text-transform: uppercase;
  letter-spacing: 4rpx;
  margin-bottom: var(--space-md);
  background: var(--gray-100);
  padding: 8rpx 24rpx;
  border-radius: var(--radius-full);
}

.card-text {
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.6;
}

.card-front .card-text {
  font-size: var(--font-2xl);
}

.card-hint {
  font-size: var(--font-xs);
  color: var(--text-placeholder);
  text-align: center;
  margin-top: var(--space-md);
}

/* 控制按钮 */
.controls {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-md) var(--space-xl) calc(env(safe-area-inset-bottom) + var(--space-md));
  background: rgba(249, 250, 251, 0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1px solid var(--border-light);
}

.progress-bar {
  height: 8rpx;
  background: var(--gray-200);
  border-radius: var(--radius-full);
  margin-bottom: var(--space-md);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--gradient-primary);
  border-radius: var(--radius-full);
  transition: width 0.3s ease;
}

.btn-group {
  display: flex;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.btn-group button {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  border-radius: var(--radius-md);
  font-size: var(--font-sm);
  font-weight: 600;
  line-height: 1.4;
  margin: 0;
  transition: transform var(--transition-fast);
}

.btn-group button:active {
  transform: scale(0.96);
}

.btn-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.btn-difficult {
  background: var(--error-bg);
  color: var(--error-color);
}

.btn-uncertain {
  background: var(--warning-bg);
  color: var(--warning-color);
}

.btn-mastered {
  background: var(--success-bg);
  color: var(--success-color);
}

.nav-btns {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.btn-nav {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--surface-color);
  color: var(--text-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
  margin: 0;
  padding: 0;
}

.btn-nav[disabled] {
  opacity: 0.5;
  background: var(--gray-100);
}

.nav-icon {
  font-size: 48rpx;
  line-height: 1;
}

.btn-shuffle {
  background: var(--primary-bg);
  color: var(--primary-color);
}

.btn-shuffle .nav-icon {
  font-size: 36rpx;
}

/* 空状态 */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-2xl) 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: var(--space-md);
  opacity: 0.5;
}

.empty-text {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--space-xs);
}

.empty-subtext {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-bottom: var(--space-xl);
}

.btn-primary {
  background: var(--gradient-primary);
  color: var(--text-inverse);
  padding: 16rpx 48rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-base);
  font-weight: 600;
  box-shadow: var(--shadow-glow);
}

/* 完成弹窗 */
.modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
}

.modal-content {
  position: relative;
  width: 80%;
  background: var(--surface-color);
  border-radius: var(--radius-xl);
  padding: var(--space-xl) var(--space-lg);
  text-align: center;
  box-shadow: var(--shadow-lg);
  animation: scaleIn var(--transition-fast) forwards;
}

.modal-icon {
  font-size: 96rpx;
  display: block;
  margin-bottom: var(--space-sm);
}

.modal-title {
  font-size: var(--font-xl);
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: var(--space-lg);
}

.modal-stats {
  display: flex;
  justify-content: space-around;
  background: var(--gray-50);
  border-radius: var(--radius-lg);
  padding: var(--space-md);
  margin-bottom: var(--space-xl);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--primary-color);
}

.stat-label {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.modal-btns {
  display: flex;
  gap: var(--space-md);
}

.modal-btns button {
  flex: 1;
  font-size: var(--font-sm);
  font-weight: 600;
  border-radius: var(--radius-full);
  padding: 20rpx 0;
  margin: 0;
}

.modal-btns .btn-secondary {
  background: var(--primary-bg);
  color: var(--primary-color);
}

.modal-btns .btn-primary {
  background: var(--gradient-primary);
  color: var(--text-inverse);
}

/* 加载 */
.loading {
  position: fixed;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--background-color);
  z-index: 50;
  color: var(--text-tertiary);
  font-size: var(--font-sm);
}
