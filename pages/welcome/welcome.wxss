/* pages/welcome/welcome.wxss */
.welcome-container {
  min-height: 100vh;
  background: var(--gradient-primary);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-2xl) var(--space-xl);
  color: var(--text-inverse);
  animation: fadeInSlow 1s ease forwards;
}

@keyframes fadeInSlow {
  from { opacity: 0; }
  to { opacity: 1; }
}

.step-indicator {
  display: flex;
  gap: var(--space-sm);
  margin-bottom: var(--space-2xl);
}

.step-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transition: all var(--transition-normal);
}

.step-dot.active {
  background: #ffffff;
  width: 48rpx;
  border-radius: 8rpx;
}

.content-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  width: 100%;
}

.icon-wrapper {
  width: 240rpx;
  height: 240rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-xl);
  backdrop-filter: blur(10px);
}

.step-icon {
  font-size: 100rpx;
}

.step-title {
  font-size: var(--font-2xl);
  font-weight: 800;
  margin-bottom: var(--space-md);
  letter-spacing: 2rpx;
}

.step-desc {
  font-size: var(--font-base);
  opacity: 0.9;
  line-height: 1.6;
  max-width: 80%;
}

.button-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  margin-bottom: var(--space-xl);
}

.btn-primary {
  width: 100%;
  background: #ffffff;
  color: var(--primary-color);
  font-size: var(--font-lg);
  font-weight: 700;
  border-radius: var(--radius-full);
  padding: 24rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  margin: 0;
}

.btn-text {
  background: transparent;
  color: rgba(255, 255, 255, 0.8);
  font-size: var(--font-sm);
  padding: 16rpx 0;
  margin: 0;
}

.btn-text::after {
  border: none;
}

.version {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.5);
}
